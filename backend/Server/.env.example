# ================================================================
#  CodeMentor AI — Backend environment variables
#  Copy this file to ".env" and fill in your own values.
#  NEVER commit the real .env file (it's in .gitignore).
# ================================================================

# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database (required for accounts, history, memory, admin) ----
# Free cluster: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://asfyrayhan1106_db_user:yCwBgg13BC4dZcbI@cluster0.ny3aciz.mongodb.net/codementor?appName=Cluster0

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_EMAILS="asfyrayhan1106@gmail.com"

# ================================================================
#  AI PROVIDERS  —  THIS PROJECT USES TWO FREE PLATFORMS TOGETHER
# ----------------------------------------------------------------
#  Each AI feature is mapped to a provider in src/services/aiService.js
#  (FEATURE_PROVIDER map):
#
#    Groq          -> AI Tutor, Bug Explainer, GitHub Repo Explainer
#    Hugging Face  -> Error Translator, Code Improver, PDF & Image Explainer
#
#  So you need BOTH keys below for all six features to use real AI.
#  Any feature whose key is missing simply falls back to demo (mock) text.
# ================================================================

# Leave AI_PROVIDER BLANK to use the per-feature mapping above.
# (If you set it to groq/huggingface/gemini/openai it OVERRIDES the map
#  and forces every feature onto that one provider. "mock" = demo mode.)
AI_PROVIDER=

# Optional: how long (ms) to wait for the AI before falling back. Default 30000.
AI_TIMEOUT_MS=30000

# ----------------------------------------------------------------
# Groq (FREE)  ->  Tutor, Bug Explainer, Repo Explainer
# Get a free key: https://console.groq.com/keys
# ----------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ----------------------------------------------------------------
# Hugging Face (FREE)  ->  Error Translator, Code Improver, PDF & Image
# Get a free token: https://huggingface.co/settings/tokens
# (token needs the "Make calls to Inference Providers" permission)
# ----------------------------------------------------------------
HF_API_KEY=""
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# ----------------------------------------------------------------
# OPTIONAL extra providers (not required for this project)
# ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- GitHub Repo Explainer (OPTIONAL) ----
GITHUB_TOKEN=
